@{
    var bodyTheme = ViewData["BodyTheme"] as string ?? "dark";
    var mainClass = ViewData["MainClass"] as string ?? "site-main--foundation";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <partial name="_Seo" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="theme-@bodyTheme">
    <a class="skip-link" href="#main">Skip to content</a>
    <partial name="_SiteHeader" />
    <main id="main" class="@mainClass">
        @RenderBody()
    </main>
    <partial name="_SiteFooter" />
    <script src="~/js/eterna.core.js" asp-append-version="true" defer></script>
    <script src="~/js/eterna.nav.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
