@{
    Layout = "_Layout";
    ViewData["MainClass"] ??= "site-main--inner";
    ViewData["HeaderTheme"] ??= "paper";
    ViewData["BodyTheme"] ??= "paper";
}
@RenderBody()

@section Styles {
    @await RenderSectionAsync("Styles", required: false)
}

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
