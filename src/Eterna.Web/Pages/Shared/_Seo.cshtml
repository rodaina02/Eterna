@using System.Text.Json
@inject IOptions<SiteOptions> SiteAccessor
@inject IOptions<CompanyOptions> CompanyAccessor
@{
    var site = SiteAccessor.Value;
    var company = CompanyAccessor.Value;
    var title = ViewData["Title"] as string ?? site.DefaultTitle;
    var description = ViewData["Description"] as string ?? site.DefaultDescription;
    var path = ViewData["CanonicalPath"] as string ?? Context.Request.Path.Value ?? "/";
    var canonical = string.IsNullOrWhiteSpace(site.CanonicalBaseUrl)
        ? null
        : $"{site.CanonicalBaseUrl.TrimEnd('/')}{path}";
    var siteUrl = string.IsNullOrWhiteSpace(site.CanonicalBaseUrl)
        ? null
        : site.CanonicalBaseUrl.TrimEnd('/');
    var ogImage = string.IsNullOrWhiteSpace(site.CanonicalBaseUrl)
        ? site.OgImagePath
        : $"{site.CanonicalBaseUrl.TrimEnd('/')}{site.OgImagePath}";
    var nonce = Context.Items[SecurityHeadersExtensions.NonceItemKey] as string;
    string Json(string? value) => JsonSerializer.Serialize(value ?? string.Empty);
    var organizationUrlJson = siteUrl is null ? string.Empty : $",\n      \"url\": {Json(siteUrl)}";
    var sameAsJson = string.IsNullOrWhiteSpace(company.SocialUrl) ? string.Empty : $",\n      \"sameAs\": [{Json(company.SocialUrl)}]";
    var websiteUrlJson = siteUrl is null ? string.Empty : $",\n      \"url\": {Json(siteUrl)}";
}
<title>@title</title>
<meta name="description" content="@description" />
@if (ViewData["Robots"] is string robots)
{
    <meta name="robots" content="@robots" />
}
@if (canonical is not null)
{
    <link rel="canonical" href="@canonical" />
}
<meta property="og:type" content="website" />
<meta property="og:title" content="@title" />
<meta property="og:description" content="@description" />
<meta property="og:image" content="@ogImage" />
@if (canonical is not null)
{
    <meta property="og:url" content="@canonical" />
}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="@title" />
<meta name="twitter:description" content="@description" />
<meta name="twitter:image" content="@ogImage" />
<link rel="icon" type="image/png" href="/images/brand/mark-lime-no-r.png" />
<!script type="application/ld+json" nonce="@nonce">
{
  "@@context": "https://schema.org",
  "@@graph": [
    {
      "@@type": "Organization",
      "name": @Html.Raw(Json(company.Name)),
      "slogan": @Html.Raw(Json(company.Slogan)),
      "email": @Html.Raw(Json(company.Email)),
      "telephone": @Html.Raw(Json(company.Phone))@Html.Raw(organizationUrlJson)@Html.Raw(sameAsJson)
    },
    {
      "@@type": "WebSite",
      "name": @Html.Raw(Json(company.Name)),
      "description": @Html.Raw(Json(site.DefaultDescription))@Html.Raw(websiteUrlJson)
    }
  ]
}
</!script>
