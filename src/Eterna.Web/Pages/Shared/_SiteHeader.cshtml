@inject IOptions<CompanyOptions> CompanyAccessor
@{
    var company = CompanyAccessor.Value;
    var theme = ViewData["HeaderTheme"] as string ?? "dark";
    var overlayTheme = theme is "dark" ? "black" : theme;
    var brandVariant = NavigationCatalog.HeaderBrandVariant(theme);
    var path = Context.Request.Path;
}
<header class="site-header site-header--@theme section-@theme" data-motion-nav>
    <a class="site-header__brand" href="/" aria-label="@company.Name home">
        <partial name="Components/_BrandMark" model="@(new BrandMarkViewModel { Variant = brandVariant })" />
    </a>

    <nav class="site-nav" aria-label="Primary">
        @foreach (var item in NavigationCatalog.Primary)
        {
            <partial name="Components/_NavLink" model="@(new NavLinkViewModel { Label = item.Label, Path = item.Path, IsActive = NavigationCatalog.IsActive(item, path) })" />
        }
    </nav>

    <div class="site-header__utilities">
        <partial name="Components/_Button" model="@(new ButtonViewModel { Text = "Start a project", Href = "/contact", CssClass = "site-header__cta", Motion = "cta" })" />
        <button
            class="nav-trigger"
            type="button"
            aria-expanded="false"
            aria-controls="site-nav-overlay"
            aria-label="Open menu"
            data-nav-trigger>
            <span class="nav-trigger__bar" aria-hidden="true"></span>
            <span class="nav-trigger__bar" aria-hidden="true"></span>
        </button>
    </div>
</header>

<div
    id="site-nav-overlay"
    class="nav-overlay nav-overlay--@overlayTheme section-@overlayTheme"
    hidden
    tabindex="-1"
    role="dialog"
    aria-modal="true"
    aria-labelledby="nav-overlay-title"
    data-motion-menu
    data-nav-overlay>
    <p class="label nav-overlay__meta" id="nav-overlay-title">Index</p>
    <nav class="nav-overlay__list" aria-label="Primary">
        @foreach (var item in NavigationCatalog.Primary)
        {
            <partial name="Components/_NavLink" model="@(new NavLinkViewModel { Label = item.Label, Path = item.Path, IsActive = NavigationCatalog.IsActive(item, path), CssClass = "nav-overlay__link" })" />
        }
    </nav>
    <partial name="Components/_Button" model="@(new ButtonViewModel { Text = "Start a project", Href = "/contact", CssClass = "nav-overlay__cta", Motion = "cta" })" />
</div>
