@page
@model StatusCodeModel
<section class="section section--loose placeholder" aria-labelledby="status-heading">
    <div class="container">
        <p class="label">@Model.Code</p>
        <h1 id="status-heading" class="display">@Model.Heading</h1>
        <p class="lede">@Model.Message</p>
        <p class="foundation__action">
            <a class="text-link" href="/">Return home</a>
        </p>
    </div>
</section>
