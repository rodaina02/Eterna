@page "/industries"
@model IndustriesIndexModel

@section Styles {
    <link rel="stylesheet" href="~/css/pages/industries.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/vendor/gsap.min.js" asp-append-version="true" defer></script>
    <script src="~/js/vendor/ScrollTrigger.min.js" asp-append-version="true" defer></script>
    <script src="~/js/pages/industries.js" asp-append-version="true" defer></script>
}

<article class="industries" data-inner-page="industries">
    <section class="inner-section inner-section--intro section-paper" aria-labelledby="page-heading">
        <div class="container">
            <partial name="Components/_PageIntro" model="@(new PageIntroViewModel {
                Index = "01",
                Eyebrow = "Industries",
                Kicker = IndustriesContent.IntroKicker,
                TitleLines = IndustriesContent.IntroTitleLines,
                Lede = IndustriesContent.IntroLede,
                Meta = IndustriesContent.IntroMeta,
                MetaLabel = "Page focus",
                HeadingId = "page-heading"
            })" />
        </div>
    </section>

    @foreach (var context in IndustriesContent.Contexts)
    {
        var clients = IndustriesContent.ClientsFor(context);
        <section
            id="@context.Id"
            class="inner-section industries-context industries-context--@context.Modifier section-@context.Theme"
            aria-labelledby="@context.Id-heading"
            data-inner-reveal>
            <div class="container industries-context__grid">
                <div class="industries-context__intro" data-reveal-heading>
                    <partial name="Components/_EditorialIndex" model="@((context.Index, context.Title))" />
                    <h2 id="@context.Id-heading" class="industries-context__title">
                        @foreach (var line in context.TitleLines)
                        {
                            <span>@line</span>
                        }
                    </h2>
                </div>
                <div class="industries-context__body">
                    <p class="lede">@context.Lede</p>
                    <ul class="inner-index-list" aria-label="@context.Title">
                        @foreach (var point in context.Points)
                        {
                            <li>@point</li>
                        }
                    </ul>
                    <ul class="industries-clients" aria-label="Portfolio context">
                        @foreach (var client in clients)
                        {
                            <li>
                                <a class="industries-clients__link" href="/work#@client.Id">
                                    <span class="industries-clients__name">@client.Name</span>
                                    <span class="industries-clients__context">@client.IndexContext</span>
                                    @if (context.ShowClientStatus && !string.IsNullOrWhiteSpace(client.Status))
                                    {
                                        <span class="industries-clients__status">@client.Status</span>
                                    }
                                </a>
                            </li>
                        }
                    </ul>
                    @if (!string.IsNullOrWhiteSpace(context.WorkLinkText))
                    {
                        <partial name="Components/_TextLink" model="@((context.WorkLinkText, "/work", true))" />
                    }
                </div>
            </div>
        </section>
    }

    <section class="inner-section industries-principle section-paper" aria-labelledby="principle-heading" data-inner-reveal>
        <div class="container industries-principle__grid">
            <div class="industries-principle__intro" data-reveal-heading>
                <partial name="Components/_EditorialIndex" model="@(("07", "Context"))" />
                <h2 id="principle-heading" class="industries-principle__title">
                    @foreach (var line in IndustriesContent.PrincipleTitleLines)
                    {
                        <span>@line</span>
                    }
                </h2>
            </div>
            <div class="industries-principle__body">
                <p class="lede">@IndustriesContent.PrincipleLede</p>
                <ul class="industries-principle__list" aria-label="Engineering principles">
                    @foreach (var principle in IndustriesContent.Principles)
                    {
                        <li data-reveal-row>
                            <span>@principle</span>
                            <hr class="rule" data-reveal-rule />
                        </li>
                    }
                </ul>
            </div>
        </div>
    </section>

    <section class="inner-section industries-work section-black" aria-labelledby="selected-heading" data-inner-reveal>
        <div class="container">
            <div class="industries-work__intro" data-reveal-heading>
                <partial name="Components/_EditorialIndex" model="@(("08", "Selected work"))" />
                <h2 id="selected-heading" class="industries-work__title">
                    @foreach (var line in IndustriesContent.SelectedTitleLines)
                    {
                        <span>@line</span>
                    }
                </h2>
                <p class="lede industries-work__lede">@IndustriesContent.SelectedLede</p>
            </div>
            <ol class="industries-work__list" aria-label="Selected clients">
                @foreach (var project in WorkContent.Clients)
                {
                    <li class="industries-work__item industries-work__item--@project.Modifier">
                        <a class="industries-work__link" href="/work#@project.Id">
                            <span class="label industries-work__num">@project.Index</span>
                            <span class="industries-work__identity">
                                @if (project.IndexLogo is { } indexLogo)
                                {
                                    <img
                                        class="industries-work__logo industries-work__logo--@project.Modifier"
                                        src="@indexLogo.Src"
                                        alt="@project.Name"
                                        width="@indexLogo.Width"
                                        height="@indexLogo.Height"
                                        loading="lazy"
                                        decoding="async" />
                                }
                                else
                                {
                                    <span class="industries-work__name">@project.Name</span>
                                }
                            </span>
                            <span class="industries-work__meta">
                                <span class="industries-work__context">@project.IndexContext</span>
                                @if (!string.IsNullOrWhiteSpace(project.Status))
                                {
                                    <span class="industries-work__status">@project.Status</span>
                                }
                            </span>
                            <span class="industries-work__action">View project</span>
                        </a>
                        <hr class="rule" data-reveal-rule />
                    </li>
                }
            </ol>
        </div>
    </section>

    <section class="inner-section industries-close section-lime" aria-labelledby="page-cta-heading" data-inner-reveal>
        <div class="container">
            <partial name="Components/_PageCta" model="@(new PageCtaViewModel {
                Index = "09",
                Eyebrow = "Next",
                TitleLines = IndustriesContent.CtaTitleLines,
                LinkText = "Start a project",
                Href = "/contact",
                HeadingId = "page-cta-heading"
            })" />
        </div>
    </section>
</article>
